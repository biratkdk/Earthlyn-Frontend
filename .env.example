# Root Docker Compose environment.
# Copy to .env for local Docker, or provide real secret values in production.

NODE_ENV=development

POSTGRES_USER=earthlyn
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=earthlyn
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=
QUEUE_DRIVER=inline
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=5

API_PORT=3001
WEB_PORT=3000
PORT=3001

DATABASE_URL=postgresql://earthlyn:replace-with-a-strong-database-password@db:5432/earthlyn?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION=7d
MESSAGE_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
AUTH_COOKIE_DOMAIN=

STRIPE_SECRET_KEY=sk_test_replace_for_local_or_sk_live_for_production
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_for_local_or_pk_live_for_production

SENDGRID_API_KEY=replace-with-real-sendgrid-api-key
SENDGRID_FROM_EMAIL=no-reply@earthlyn.local

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

THROTTLE_TTL=60
THROTTLE_LIMIT=100
BCRYPT_ROUNDS=12
PROCESSING_FEE_RATE=0.05
NEXT_PUBLIC_PROCESSING_FEE_RATE=0.05
ECO_POINTS_PER_DOLLAR=1

UPLOAD_DIR=/app/public/uploads
UPLOAD_STORAGE_DRIVER=local
UPLOAD_S3_ENDPOINT=
UPLOAD_S3_REGION=auto
UPLOAD_S3_BUCKET=
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
UPLOAD_S3_PUBLIC_BASE_URL=
UPLOAD_S3_FORCE_PATH_STYLE=false
ALLOW_ADMIN_REGISTRATION=false
REQUIRE_EMAIL_VERIFICATION=false
AUTO_FULFILL=false
AUTO_FULFILL_STEP_HOURS=24
ENABLE_SWAGGER=false
