# Database Configuration
DATABASE_URL="postgresql://earthlyn:replace-with-local-password@localhost:5432/earthlyn?schema=public"

# JWT Configuration
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRATION="7d"
MESSAGE_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"
AUTH_COOKIE_DOMAIN=""

# Application Settings
PORT=3001
NODE_ENV="development"
UPLOAD_DIR="public/uploads"
UPLOAD_STORAGE_DRIVER="local"

# S3/R2-compatible upload storage. Set UPLOAD_STORAGE_DRIVER="s3" in production.
UPLOAD_S3_ENDPOINT=""
UPLOAD_S3_REGION="auto"
UPLOAD_S3_BUCKET=""
UPLOAD_S3_ACCESS_KEY_ID=""
UPLOAD_S3_SECRET_ACCESS_KEY=""
UPLOAD_S3_PUBLIC_BASE_URL=""
UPLOAD_S3_FORCE_PATH_STYLE="false"

# Stripe Payment Configuration
STRIPE_SECRET_KEY="sk_test_replace_for_local_or_sk_live_for_production"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_real_webhook_secret"

# Email Configuration
SENDGRID_API_KEY="replace-with-real-sendgrid-api-key"
SENDGRID_FROM_EMAIL="no-reply@earthlyn.local"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Redis Configuration (for Bull Queue)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="replace-with-local-redis-password"
REDIS_URL=""
QUEUE_DRIVER="inline"
QUEUE_JOB_ATTEMPTS=3
QUEUE_JOB_BACKOFF_MS=5000
QUEUE_WORKER_CONCURRENCY=5

# Rate Limiting Configuration
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ECO Points Configuration
ECO_POINTS_PER_DOLLAR=1
PROCESSING_FEE_RATE=0.05

# Bcrypt Configuration
BCRYPT_ROUNDS=12

# Auto Fulfillment (optional)
AUTO_FULFILL="false"
AUTO_FULFILL_STEP_HOURS=24

# Swagger should stay disabled in production unless intentionally exposed
ENABLE_SWAGGER="false"

# Public registration for privileged roles must remain disabled in production
ALLOW_ADMIN_REGISTRATION="false"

# Require verified email before login/JWT access
REQUIRE_EMAIL_VERIFICATION="false"
