{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "cd apps/backend && npm ci --include=dev && npm run build",
    "watchPatterns": [
      "/apps/backend/**",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/backend && node scripts/start-production.mjs",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
